{
	"compilerOptions": {
		"target": "es2019",
		"lib": ["dom", "dom.iterable", "esnext"],
		"module": "commonjs",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node", "@playwright/test"]
	},
	"include": ["./**/*.ts"]
}
